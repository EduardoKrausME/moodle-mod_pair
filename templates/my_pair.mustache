{{!
    @template mod_pair/my_pair

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-pair-my-pair card mt-3">
    <div class="card-body text-center">
        <h3>{{#str}}yourpair,pair{{/str}}</h3>
        <div class="mod-pair-avatar mb-2">{{{partnerpicture}}}</div>
        <p class="h4"><a href="{{partnerprofileurl}}">{{partnername}}</a></p>
        {{#canleave}}
            <form method="post" action="view.php?id={{cmid}}" class="mt-3">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="leave">
                <button type="submit" class="btn btn-outline-secondary">{{#str}}changepair,pair{{/str}}</button>
            </form>
        {{/canleave}}
    </div>
</div>
